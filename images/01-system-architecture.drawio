        <!-- =========== SIDE NOTES =========== -->
        <mxCell id="note-cache" value="Public discovery is fast and unauthenticated (PRD §6).&#10;Vista uses SSR/ISR; Haven public endpoints set Cache-Control." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1280" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note-kafka-scope" value="Kafka is used for exactly two events (PRD §7).&#10;Listing approvals, verification updates, comments,&#10;messaging — all DB-backed sync notifications." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="480" y="1280" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note-outbox" value="Outbox pattern guarantees exactly-once-effective delivery:&#10;DB row + outbox row written in one TX, then relay ships to Kafka.&#10;Without this, a missed event = a missed deal (PRD §7)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="920" y="1280" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note-rbac" value="RBAC roles: OWNER, AGENT, APPLICANT, ADMIN.&#10;Admin is seeded only — no self-registration (PRD §4.10)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1280" width="460" height="60" as="geometry" />
