          <mxGeometry x="1010" y="1160" width="820" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pg-note2" value="Single PG instance acceptable for capstone scope; managed PG + read replicas in production" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1185" width="820" height="20" as="geometry" />
