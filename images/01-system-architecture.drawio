        <!-- Outbox Relay → reads PG / writes Kafka -->
        <mxCell id="e-relay-pg" value="poll outbox (FOR UPDATE SKIP LOCKED)" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=9;" edge="1" parent="1" source="haven-outbox" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-relay-kafka" value="produce (at-least-once)" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="haven-outbox" target="kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Kafka → Notification Consumer -->
        <mxCell id="e-kafka-consumer" value="consume (idempotent handler)" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=9;" edge="1" parent="1" source="kafka" target="haven-consumer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Notification Consumer → Postgres -->
        <mxCell id="e-consumer-pg" value="insert notification row" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="haven-consumer" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Kafka ↔ Zookeeper -->
        <mxCell id="e-kafka-zk" value="coordination" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#d79b00;fontSize=9;" edge="1" parent="1" source="kafka" target="zookeeper">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dream AI → LLM -->
        <mxCell id="e-dreamai-llm" value="HTTPS (out-of-process)" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;dashed=1;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-dream-ai" target="ext-llm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1500" y="655" />
              <mxPoint x="1500" y="115" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Operator → Postgres (seed) -->
        <mxCell id="e-operator-pg" value="Flyway: seed admin" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;dashed=1;fontSize=9;" edge="1" parent="1" source="ext-operator" target="postgres">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1790" y="1020" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
