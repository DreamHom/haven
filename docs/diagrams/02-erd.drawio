<mxfile host="app.diagrams.net" modified="2026-05-05T00:00:00.000Z" agent="DreamHomes-Capstone" version="24.0.0">
  <diagram name="ERD" id="dreamhomes-erd">
    <mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="DreamHomes — Entity Relationship Diagram (Capstone 2026)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Notation: Crow's-foot. PK = primary key · FK = foreign key · UQ = unique · NN = NOT NULL · ENUM held as VARCHAR + CHECK · IDs are BIGSERIAL (not UUID) — UUID-typed fields here are app-level event ids · Dashed edges = no FK, conceptual link only · ★ Phase N = entity actually shipped in that phase; entities without ★ are forward-looking design (not yet in schema)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="2200" height="48" as="geometry" />
        </mxCell>

        <!-- =========== IDENTITY =========== -->
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;email : VARCHAR(255) UQ NN&lt;br/&gt;phone : VARCHAR(32)&lt;br/&gt;password_hash : VARCHAR(255) NN&lt;br/&gt;full_name : VARCHAR(120) NN&lt;br/&gt;role : ENUM(OWNER,AGENT,&lt;br/&gt;&amp;nbsp;&amp;nbsp;APPLICANT,ADMIN) NN&lt;br/&gt;status : ENUM(ACTIVE,SUSPENDED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;DEACTIVATED) DEFAULT ACTIVE&lt;br/&gt;identity_verified : BOOLEAN&lt;br/&gt;created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="240" as="geometry" />
        </mxCell>

        <mxCell id="agentprofile" value="&lt;b&gt;AgentProfile&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK,FK&lt;/b&gt; user_id : UUID → User&lt;br/&gt;bio : TEXT&lt;br/&gt;specializations : JSONB&lt;br/&gt;locations_covered : JSONB&lt;br/&gt;languages : JSONB&lt;br/&gt;years_experience : INT&lt;br/&gt;license_number : VARCHAR(120)&lt;br/&gt;cac_registration : VARCHAR(120)&lt;br/&gt;fee_structure : JSONB &lt;i&gt;public&lt;/i&gt;&lt;br/&gt;credential_verified : BOOLEAN&lt;br/&gt;approved_at : TIMESTAMPTZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="280" height="240" as="geometry" />
        </mxCell>

        <!-- =========== PROPERTY / LISTING =========== -->
        <mxCell id="property" value="&lt;b&gt;Property&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; owner_user_id : UUID → User&lt;br/&gt;address_line1 : VARCHAR(255) NN&lt;br/&gt;address_line2 : VARCHAR(255)&lt;br/&gt;city : VARCHAR(120) NN&lt;br/&gt;state : VARCHAR(120) NN&lt;br/&gt;country : VARCHAR(64) NN&lt;br/&gt;postcode : VARCHAR(32)&lt;br/&gt;type : ENUM(APARTMENT,HOUSE,&lt;br/&gt;&amp;nbsp;&amp;nbsp;LAND,COMMERCIAL) NN&lt;br/&gt;bedrooms : INT&lt;br/&gt;bathrooms : INT&lt;br/&gt;size_sqm : NUMERIC&lt;br/&gt;description : TEXT&lt;br/&gt;documents_verified : BOOLEAN&lt;br/&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="280" height="320" as="geometry" />
        </mxCell>

        <mxCell id="listing" value="&lt;b&gt;Listing&lt;/b&gt;  @Version&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGSERIAL&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; property_id : BIGINT → Property&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; owner_id : BIGINT → User &lt;i&gt;denorm.&lt;/i&gt;&lt;br/&gt;listing_type : ENUM(RENT, SALE) NN&lt;br/&gt;asking_price : NUMERIC(12,2) NN  &lt;i&gt;CHECK &gt; 0&lt;/i&gt;&lt;br/&gt;currency : VARCHAR(3) NN  &lt;i&gt;default NGN&lt;/i&gt;&lt;br/&gt;caution_fee, service_charge, agency_fee : NUMERIC&lt;br/&gt;status : ENUM(LIVE, PAUSED, CLOSED) NN  &lt;i&gt;default LIVE&lt;/i&gt;&lt;br/&gt;approved_at : TIMESTAMPTZ  &lt;i&gt;admin verified badge ★ Phase 5&lt;/i&gt;&lt;br/&gt;view_count : BIGINT NN  &lt;i&gt;atomic UPDATE ★ Phase 9&lt;/i&gt;&lt;br/&gt;version : BIGINT &lt;i&gt;@Version&lt;/i&gt;&lt;br/&gt;created_at, updated_at : TIMESTAMPTZ&lt;br/&gt;&lt;i&gt;Composite IDX (status, created_at DESC)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;PRD §4.1: LIVE on creation; admin badges only&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="100" width="320" height="340" as="geometry" />
        </mxCell>

        <mxCell id="listingphoto" value="&lt;b&gt;ListingPhoto&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : UUID → Listing&lt;br/&gt;url : VARCHAR(512) NN &lt;i&gt;metadata only&lt;/i&gt;&lt;br/&gt;display_order : INT NN&lt;br/&gt;caption : VARCHAR(255)&lt;br/&gt;uploaded_at : TIMESTAMPTZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="100" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- =========== ENGAGEMENT =========== -->
        <mxCell id="listingsave" value="&lt;b&gt;ListingSave&lt;/b&gt;  ★ Phase 9&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; (user_id, listing_id)  &lt;i&gt;composite&lt;/i&gt;&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; user_id : BIGINT → User&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : BIGINT → Listing&lt;br/&gt;saved_at : TIMESTAMPTZ NN&lt;br/&gt;&lt;i&gt;IDX(user_id, saved_at DESC)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;IDX(listing_id) — saver count&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="100" width="260" height="180" as="geometry" />
        </mxCell>

        <mxCell id="listinglike" value="&lt;b&gt;ListingLike&lt;/b&gt;  &lt;i&gt;deferred&lt;/i&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; (user_id, listing_id)&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; user_id : BIGINT → User&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : BIGINT → Listing&lt;br/&gt;liked_at : TIMESTAMPTZ&lt;br/&gt;&lt;i&gt;Same shape as ListingSave;&lt;/i&gt;&lt;br/&gt;&lt;i&gt;collapse if both ship.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1700" y="100" width="260" height="180" as="geometry" />
        </mxCell>

        <mxCell id="listingreview" value="&lt;b&gt;ListingReview&lt;/b&gt;  ★ Phase 10&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGSERIAL&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : BIGINT → Listing&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; reviewer_user_id : BIGINT → User&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; reviewee_user_id : BIGINT → User&lt;br/&gt;rating : SMALLINT NN  &lt;i&gt;CHECK 1..5&lt;/i&gt;&lt;br/&gt;body : TEXT NN  &lt;i&gt;CHECK len 1..2000&lt;/i&gt;&lt;br/&gt;created_at : TIMESTAMPTZ NN&lt;br/&gt;&lt;i&gt;UQ(listing, reviewer, reviewee)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;CHECK reviewer ≠ reviewee&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Service gate: listing.status = CLOSED&lt;/i&gt;&lt;br/&gt;&lt;i&gt;+ reviewer = owner OR has ACCEPTED offer&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="2000" y="100" width="280" height="280" as="geometry" />
        </mxCell>

        <!-- =========== AGENT MANAGEMENT =========== -->
        <mxCell id="agentlisting" value="&lt;b&gt;AgentListing&lt;/b&gt;  ★ Phase 7  @Version&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGSERIAL&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : BIGINT → Listing&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; agent_user_id : BIGINT → User&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; requested_by_owner_id : BIGINT → User&lt;br/&gt;status : ENUM(REQUESTED, ACCEPTED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;DECLINED, REVOKED)&lt;br/&gt;decision_reason : TEXT&lt;br/&gt;requested_at, decided_at : TIMESTAMPTZ&lt;br/&gt;version : BIGINT &lt;i&gt;@Version&lt;/i&gt;&lt;br/&gt;&lt;i&gt;CHECK decision_complete&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Partial UQ(listing_id) WHERE status=REQUESTED&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Partial UQ(listing_id) WHERE status=ACCEPTED&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="500" width="280" height="240" as="geometry" />
        </mxCell>

        <!-- =========== INSPECTION =========== -->
        <mxCell id="inspectionslot" value="&lt;b&gt;InspectionSlot&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : UUID → Listing&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; created_by_user_id : UUID → User&lt;br/&gt;start_at : TIMESTAMPTZ NN&lt;br/&gt;end_at : TIMESTAMPTZ NN&lt;br/&gt;status : ENUM(OPEN,BOOKED,CANCELLED)&lt;br/&gt;&lt;i&gt;EXCLUDE USING GIST&lt;/i&gt;&lt;br/&gt;&lt;i&gt;(listing_id WITH =,&lt;/i&gt;&lt;br/&gt;&lt;i&gt;tstzrange(start_at,end_at) WITH &amp;&amp;)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;→ no overlapping slots per listing&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="500" width="280" height="240" as="geometry" />
        </mxCell>

        <mxCell id="inspectionrequest" value="&lt;b&gt;InspectionRequest&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; slot_id : UUID UQ → InspectionSlot&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; applicant_user_id : UUID → User&lt;br/&gt;status : ENUM(REQUESTED,CONFIRMED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;RESCHEDULED,DECLINED,COMPLETED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;NO_SHOW,CANCELLED)&lt;br/&gt;post_inspection_notes : TEXT&lt;br/&gt;no_show : BOOLEAN DEFAULT FALSE&lt;br/&gt;requested_at, confirmed_at, completed_at&lt;br/&gt;&lt;i&gt;UQ(slot_id) → no two requests on same slot&lt;/i&gt;&lt;br/&gt;&lt;i&gt;PRD §6: data-layer conflict prevention&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="500" width="320" height="240" as="geometry" />
        </mxCell>

        <!-- =========== OFFER =========== -->
        <mxCell id="offer" value="&lt;b&gt;Offer&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : UUID → Listing&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; applicant_user_id : UUID → User&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; parent_offer_id : UUID → Offer &lt;i&gt;nullable&lt;/i&gt;&lt;br/&gt;intent : ENUM(RENT,BUY) NN&lt;br/&gt;amount : NUMERIC NN&lt;br/&gt;terms : TEXT&lt;br/&gt;agent_recommendation : TEXT&lt;br/&gt;status : ENUM(SUBMITTED,COUNTERED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;ACCEPTED,REJECTED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;WITHDRAWN,EXPIRED)&lt;br/&gt;version : BIGINT &lt;i&gt;@Version&lt;/i&gt;&lt;br/&gt;submitted_at, decided_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="1420" y="500" width="280" height="280" as="geometry" />
        </mxCell>

        <!-- =========== VERIFICATION / COMMENT =========== -->
        <mxCell id="verification" value="&lt;b&gt;Verification&lt;/b&gt;  &lt;i&gt;(polymorphic)&lt;/i&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;type : ENUM(OWNER_IDENTITY,&lt;br/&gt;&amp;nbsp;&amp;nbsp;PROPERTY_DOCS,AGENT_CREDENTIAL,&lt;br/&gt;&amp;nbsp;&amp;nbsp;APPLICANT_ID) NN&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; subject_user_id : UUID → User &lt;i&gt;null&lt;/i&gt;&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; subject_property_id : UUID → Property &lt;i&gt;null&lt;/i&gt;&lt;br/&gt;document_metadata : JSONB&lt;br/&gt;status : ENUM(PENDING,APPROVED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;REJECTED,MORE_INFO_REQUESTED)&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; reviewed_by_admin_id : UUID → User &lt;i&gt;null&lt;/i&gt;&lt;br/&gt;reviewer_notes : TEXT&lt;br/&gt;submitted_at, reviewed_at&lt;br/&gt;&lt;i&gt;CHECK: PROPERTY_DOCS ⇒ property set,&lt;/i&gt;&lt;br/&gt;&lt;i&gt;else user set (XOR)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="820" width="320" height="320" as="geometry" />
        </mxCell>

        <mxCell id="comment" value="&lt;b&gt;Comment&lt;/b&gt;  ★ Phase 6&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGSERIAL&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : BIGINT → Listing&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; author_user_id : BIGINT → User&lt;br/&gt;body : TEXT NN  &lt;i&gt;CHECK len 1..4000&lt;/i&gt;&lt;br/&gt;deleted_at : TIMESTAMPTZ  &lt;i&gt;soft delete&lt;/i&gt;&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; deleted_by_user_id : BIGINT → User&lt;br/&gt;deletion_reason : TEXT&lt;br/&gt;created_at : TIMESTAMPTZ NN&lt;br/&gt;&lt;i&gt;CHECK delete_complete (paired)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Partial IDX (listing, created_at) WHERE deleted_at IS NULL&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="820" width="280" height="200" as="geometry" />
        </mxCell>

        <!-- =========== COMMUNICATION =========== -->
        <mxCell id="messagethread" value="&lt;b&gt;MessageThread&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : UUID → Listing&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; participant_a_user_id : UUID → User&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; participant_b_user_id : UUID → User&lt;br/&gt;created_at&lt;br/&gt;&lt;i&gt;UQ(listing_id, LEAST(a,b), GREATEST(a,b))&lt;/i&gt;&lt;br/&gt;&lt;i&gt;→ one thread per pair per listing&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="820" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="message" value="&lt;b&gt;Message&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; thread_id : UUID → MessageThread&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; sender_user_id : UUID → User&lt;br/&gt;body : TEXT NN&lt;br/&gt;sent_at : TIMESTAMPTZ NN&lt;br/&gt;read_at : TIMESTAMPTZ &lt;i&gt;null&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="1420" y="820" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="notification" value="&lt;b&gt;Notification&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGSERIAL&lt;br/&gt;event_id : UUID UQ &lt;i&gt;null for SYNC&lt;/i&gt;&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; recipient_user_id : UUID → User&lt;br/&gt;kind : ENUM(INSPECTION_REQUESTED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;OFFER_SUBMITTED,LISTING_APPROVED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;LISTING_TAKEDOWN,&lt;br/&gt;&amp;nbsp;&amp;nbsp;VERIFICATION_APPROVED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;VERIFICATION_REJECTED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;COMMENT_POSTED, …)&lt;br/&gt;source : ENUM(SYNC, ASYNC_KAFKA)&lt;br/&gt;payload : TEXT (JSON)&lt;br/&gt;read_at : TIMESTAMPTZ &lt;i&gt;null&lt;/i&gt;&lt;br/&gt;created_at&lt;br/&gt;&lt;i&gt;IDX(recipient,read_at,created_at DESC)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;event_id UQ → at-least-once dedup&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="1740" y="820" width="320" height="320" as="geometry" />
        </mxCell>

        <!-- =========== OPERATIONS =========== -->
        <mxCell id="ad" value="&lt;b&gt;Ad&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; advertiser_user_id : UUID → User&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; listing_id : UUID → Listing &lt;i&gt;null&lt;/i&gt;&lt;br/&gt;&lt;i&gt;(null when type=FEATURED_AGENT)&lt;/i&gt;&lt;br/&gt;type : ENUM(FEATURED_LISTING,&lt;br/&gt;&amp;nbsp;&amp;nbsp;FEATURED_AGENT) NN&lt;br/&gt;starts_at, ends_at : TIMESTAMPTZ&lt;br/&gt;status : ENUM(PENDING_APPROVAL,&lt;br/&gt;&amp;nbsp;&amp;nbsp;APPROVED,ACTIVE,EXPIRED,REJECTED)&lt;br/&gt;spend_amount : NUMERIC&lt;br/&gt;&lt;i&gt;CHECK: type=FEATURED_LISTING ⇒&lt;/i&gt;&lt;br/&gt;&lt;i&gt;listing_id NOT NULL&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="1200" width="320" height="260" as="geometry" />
        </mxCell>

        <mxCell id="adminauditlog" value="&lt;b&gt;AdminAuditLog&lt;/b&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGSERIAL&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; admin_id : BIGINT → User&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;CHECK role = ADMIN&lt;/i&gt;&lt;br/&gt;action : ENUM(&lt;br/&gt;&amp;nbsp;&amp;nbsp;VERIFICATION_APPROVED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;VERIFICATION_REJECTED,&lt;br/&gt;&amp;nbsp;&amp;nbsp;LISTING_APPROVED,LISTING_TAKEDOWN,&lt;br/&gt;&amp;nbsp;&amp;nbsp;USER_SUSPENDED,USER_REACTIVATED) NN&lt;br/&gt;target_type : ENUM(&lt;br/&gt;&amp;nbsp;&amp;nbsp;VERIFICATION,LISTING,USER) NN&lt;br/&gt;target_id : BIGINT NN&lt;br/&gt;metadata : JSONB &lt;i&gt;reason, prev state, etc&lt;/i&gt;&lt;br/&gt;created_at : TIMESTAMPTZ NN&lt;br/&gt;&lt;i&gt;IDX(admin_id, created_at DESC)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;IDX(target_type, target_id, created_at DESC)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Append-only — no UPDATE/DELETE&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="1200" width="320" height="320" as="geometry" />
        </mxCell>

        <mxCell id="outbox" value="&lt;b&gt;Outbox&lt;/b&gt;  &lt;i&gt;(transactional)&lt;/i&gt;&lt;hr style=&quot;margin:2px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGSERIAL&lt;br/&gt;event_id : UUID UQ NN &lt;i&gt;dedup key&lt;/i&gt;&lt;br/&gt;aggregate_type : VARCHAR(64) NN&lt;br/&gt;aggregate_id : BIGINT NN&lt;br/&gt;event_type : VARCHAR(255) NN&lt;br/&gt;&lt;i&gt;(INSPECTION_REQUESTED,&lt;/i&gt;&lt;br/&gt;&lt;i&gt;OFFER_SUBMITTED)&lt;/i&gt;&lt;br/&gt;topic, partition_key : VARCHAR&lt;br/&gt;payload : TEXT NN&lt;br/&gt;created_at : TIMESTAMPTZ NN&lt;br/&gt;published_at : TIMESTAMPTZ &lt;i&gt;null = unsent&lt;/i&gt;&lt;br/&gt;&lt;i&gt;IDX(created_at) WHERE published_at IS NULL&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1200" width="320" height="280" as="geometry" />
        </mxCell>

        <!-- =========== NOTES =========== -->
        <mxCell id="note-roles" value="Domain rules enforced by ENUM + CHECK constraints:&#10;• Property.owner_user_id → User WHERE role=OWNER&#10;• AgentListing.agent_user_id → User WHERE role=AGENT&#10;• Verification.reviewed_by_admin_id → User WHERE role=ADMIN&#10;• Lead temperature (cold/warm/hot) is derived, not stored&#10;• Responsiveness metrics derived as a view on messages + inspection timestamps" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1200" width="540" height="120" as="geometry" />
        </mxCell>

        <mxCell id="note-files" value="No raw file storage in DB (PRD §6).&#10;ListingPhoto.url, Verification.document_metadata point at external object storage.&#10;Object-storage layer is out of capstone scope per PRD §9." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
