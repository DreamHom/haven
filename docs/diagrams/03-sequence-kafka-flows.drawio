            <mxPoint x="2150" y="1620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="LL9" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2460" y="130" as="sourcePoint" />
            <mxPoint x="2460" y="1620" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== SYNC PHASE messages ===== -->

        <!-- 1. Applicant → Vista -->
        <mxCell id="m1" value="1. POST /api/inspection-requests { slotId, listingId }" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="170" as="sourcePoint" />
            <mxPoint x="420" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. Vista → Sec Filter -->
        <mxCell id="m2" value="2. REST + Authorization: Bearer &lt;JWT&gt;" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="210" as="sourcePoint" />
            <mxPoint x="700" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. Sec Filter → Inspection Svc -->
        <mxCell id="m3" value="3. verify JWT, role=APPLICANT, forward principal" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="250" as="sourcePoint" />
            <mxPoint x="980" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4. Inspection Svc → Postgres BEGIN -->
        <mxCell id="m4" value="4. BEGIN TRANSACTION" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="300" as="sourcePoint" />
            <mxPoint x="1270" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5. INSERT inspection_request -->
        <mxCell id="m5" value="5. INSERT inspection_request (slot_id, applicant_id, status=REQUESTED)  ── UNIQUE(slot_id) enforced" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="340" as="sourcePoint" />
            <mxPoint x="1270" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Branch note: 409 Conflict path -->
        <mxCell id="branch1" value="Concurrent-request branch:&#10;&#10;If slot_id already taken → Postgres raises 23505 unique_violation.&#10;Inspection Svc rolls back TX, returns 409 Conflict to Applicant.&#10;&#10;Loser never reaches the outbox → Kafka sees only one event for this slot.&#10;&#10;PRD §6: &quot;no race conditions — handled at the data layer.&quot;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="700" height="120" as="geometry" />
        </mxCell>

        <!-- 6. INSERT outbox -->
        <mxCell id="m6" value="6. INSERT outbox (event_type=INSPECTION_REQUESTED, aggregate_id=request.id, payload=JSON, published_at=NULL)" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="430" as="sourcePoint" />
            <mxPoint x="1270" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 7. COMMIT -->
        <mxCell id="m7" value="7. COMMIT  (atomic: request + outbox row written together)" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="470" as="sourcePoint" />
            <mxPoint x="1270" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 8. Postgres → Inspection Svc OK -->
        <mxCell id="m8" value="8. OK" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="510" as="sourcePoint" />
            <mxPoint x="980" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 9. Inspection Svc → Sec Filter 201 -->
        <mxCell id="m9" value="9. 201 Created { requestId, status: REQUESTED }" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="550" as="sourcePoint" />
            <mxPoint x="700" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 10. Sec Filter → Vista -->
        <mxCell id="m10" value="10. 201 Created" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="590" as="sourcePoint" />
            <mxPoint x="420" y="590" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 11. Vista → Applicant -->
        <mxCell id="m11" value="11. UI confirmation — &quot;Inspection requested&quot;" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="630" as="sourcePoint" />
            <mxPoint x="140" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== ASYNC BOUNDARY BANNER ===== -->
        <mxCell id="async-banner" value="═══  ASYNC BOUNDARY  ·  Applicant has their 201 response.  The notification path runs INDEPENDENTLY below this line.  ═══" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="2540" height="40" as="geometry" />
        </mxCell>

        <!-- ===== ASYNC PHASE messages ===== -->

        <!-- 12. Outbox Relay polls -->
        <mxCell id="m12" value="12. SELECT * FROM outbox WHERE published_at IS NULL FOR UPDATE SKIP LOCKED LIMIT N" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1560" y="760" as="sourcePoint" />
            <mxPoint x="1270" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 13. Postgres returns rows -->
        <mxCell id="m13" value="13. unpublished rows" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="800" as="sourcePoint" />
            <mxPoint x="1560" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 14. Outbox Relay → Kafka publish -->
        <mxCell id="m14" value="14. produce(topic=inspection.requested, key=listingId, value=payload, headers={event_id})" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1560" y="850" as="sourcePoint" />
            <mxPoint x="1850" y="850" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 15. Kafka ack -->
        <mxCell id="m15" value="15. ack (offset=N, partition=P)" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1850" y="890" as="sourcePoint" />
            <mxPoint x="1560" y="890" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 16. Outbox Relay marks published -->
        <mxCell id="m16" value="16. UPDATE outbox SET published_at=NOW() WHERE id=...  ── only after Kafka acks" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1560" y="930" as="sourcePoint" />
            <mxPoint x="1270" y="930" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Crash note -->
        <mxCell id="crash-note" value="Crash between m14 and m16?&#10;Outbox row stays unpublished → next tick re-publishes.&#10;Kafka may see duplicate → consumer dedupes by event_id.&#10;Net effect: at-least-once delivery, exactly-once-effective application." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="640" height="100" as="geometry" />
        </mxCell>

        <!-- 17. Kafka → Notif Consumer deliver -->
        <mxCell id="m17" value="17. deliver(record)  ── consumer group=notification-svc; auto-commit=false" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1850" y="990" as="sourcePoint" />
            <mxPoint x="2150" y="990" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 18. Notif Consumer → Postgres lookup recipient -->
        <mxCell id="m18" value="18. SELECT agent_user_id FROM agent_listings WHERE listing_id=? AND status='ACCEPTED'" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2150" y="1040" as="sourcePoint" />
            <mxPoint x="1270" y="1040" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 19. Postgres → Notif Consumer recipient -->
        <mxCell id="m19" value="19. agent_user_id (or NULL → fall back to property.owner_user_id)" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="1080" as="sourcePoint" />
            <mxPoint x="2150" y="1080" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 20. Notif Consumer → Postgres INSERT notification (idempotent) -->
        <mxCell id="m20" value="20. INSERT INTO notifications (recipient_user_id, type=INSPECTION_REQUESTED, ref_entity_id=request.id, source=ASYNC_KAFKA, event_id=...)  ON CONFLICT (event_id) DO NOTHING" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2150" y="1130" as="sourcePoint" />
            <mxPoint x="1270" y="1130" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 21. Notif Consumer → Kafka commit offset -->
        <mxCell id="m21" value="21. commit offset (manual ack — only after DB insert succeeds)" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2150" y="1180" as="sourcePoint" />
            <mxPoint x="1850" y="1180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Idempotency note -->
        <mxCell id="idempo-note" value="Why insert BEFORE offset commit:&#10;• If we committed first and crashed before insert, the notification would be lost.&#10;• Insert-then-commit gives at-least-once; ON CONFLICT(event_id) keeps it idempotent.&#10;Net: missed delivery is impossible (PRD §7: &quot;missed notification = missed deal&quot;)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="640" height="100" as="geometry" />
        </mxCell>

        <!-- ===== Recipient pull phase ===== -->

        <!-- 22. Recipient → Vista pulls notifications -->
        <mxCell id="m22" value="22. (later) GET /api/notifications?unread=true" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2460" y="1260" as="sourcePoint" />
            <mxPoint x="420" y="1260" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 23. Vista → Postgres (via Haven, abbreviated) -->
        <mxCell id="m23" value="23. SELECT FROM notifications WHERE recipient_user_id=? AND read_at IS NULL ORDER BY created_at DESC" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="1300" as="sourcePoint" />
            <mxPoint x="1270" y="1300" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 24. Postgres → Vista return rows -->
        <mxCell id="m24" value="24. notification rows" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="1340" as="sourcePoint" />
            <mxPoint x="420" y="1340" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 25. Vista → Recipient render -->
        <mxCell id="m25" value="25. render unread badge + dashboard alert  ── recipient sees the inspection request" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#000000;fontSize=11;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="1380" as="sourcePoint" />
            <mxPoint x="2460" y="1380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== END STATE box ===== -->
        <mxCell id="endstate" value="END STATE&#10;&#10;• inspection_requests row exists  (status = REQUESTED, slot_id locked by UNIQUE)&#10;• outbox row exists with published_at set&#10;• Kafka has consumed offset committed&#10;• notifications row exists for the assigned agent (or owner if self-managing)&#10;• Recipient sees badge on next dashboard fetch&#10;&#10;Loser of a concurrent slot race got 409 Conflict at step 5 — never produced an event." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1440" width="2540" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

