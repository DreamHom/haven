        <!-- TITLE + LEGEND -->
        <mxCell id="title" value="DreamHomes Haven — Application-Layer Class Diagram (Phase 0–5)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Layered: Controller → Service → Repository → Entity. Stereotypes shown as «service», «controller», «repository», «entity», «exception», «filter», «config». Solid arrows = composition / dependency. Dashed = inheritance ▷ or implements. Colors mirror the ERD: identity (blue), property/listing (green), inspection/offer (red), verification (purple), notification/outbox (orange), admin (grey)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="2900" height="36" as="geometry" />
        </mxCell>

