        <mxCell id="r-globex-domex" value="@ExceptionHandler" style="endArrow=open;dashed=0;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="cls-GlobalEx" target="cls-DomainException"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Verification submission: service uses repos in user/property -->
        <mxCell id="r-verifsvc-user" style="endArrow=open;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="cls-VerifService" target="cls-UserRepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-verifsvc-prop" style="endArrow=open;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="cls-VerifService" target="cls-PropertyRepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-verifsvc-repo" style="endArrow=open;dashed=0;html=1;rounded=0;" edge="1" parent="1" source="cls-VerifService" target="cls-VerifRepo"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Outbox / event flow -->
        <mxCell id="r-offersvc-outbox" value="writes" style="endArrow=open;dashed=0;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" parent="1" source="cls-OfferService" target="cls-OutboxEvent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-inspsvc-outbox" value="writes" style="endArrow=open;dashed=0;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" parent="1" source="cls-InspectionService" target="cls-OutboxEvent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-offersvc-evt" value="fires after-commit" style="endArrow=open;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" parent="1" source="cls-OfferService" target="cls-OutboxRowReady"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-inspsvc-evt" value="fires after-commit" style="endArrow=open;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" parent="1" source="cls-InspectionService" target="cls-OutboxRowReady"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-relay-evt" value="@TransactionalEventListener AFTER_COMMIT" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="cls-OutboxRelay" target="cls-OutboxRowReady"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-relay-outbox" value="claims + publishes" style="endArrow=open;dashed=0;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="cls-OutboxRelay" target="cls-OutboxEvent"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Kafka listeners → NotificationService → Notification -->
        <mxCell id="r-insp-listener-svc" style="endArrow=open;dashed=0;html=1;rounded=0;" edge="1" parent="1" source="cls-InspListener" target="cls-NotifService"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-offer-listener-svc" style="endArrow=open;dashed=0;html=1;rounded=0;" edge="1" parent="1" source="cls-OfferListener" target="cls-NotifService"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-notifsvc-repo" style="endArrow=open;dashed=0;html=1;rounded=0;" edge="1" parent="1" source="cls-NotifService" target="cls-NotifRepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-notifrepo-notif" style="endArrow=open;dashed=0;html=1;rounded=0;" edge="1" parent="1" source="cls-NotifRepo" target="cls-Notification"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Listing service → Listing -->
        <mxCell id="r-listsvc-listing" style="endArrow=open;dashed=0;html=1;rounded=0;" edge="1" parent="1" source="cls-ListingService" target="cls-Listing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-listsvc-prop" value="bulk-fetches" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="cls-ListingService" target="cls-Property"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Admin services → cross-package collaborations (single representative arrow each, the note details the rest) -->
        <mxCell id="r-adminVerif-VR" value="reads / writes" style="endArrow=open;dashed=0;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" parent="1" source="cls-AdminVerifService" target="cls-VerifRepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-adminVerif-Audit" value="audits" style="endArrow=open;dashed=0;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="cls-AdminVerifService" target="cls-AdminAuditRepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-adminVerif-Notif" value="sync notify" style="endArrow=open;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" parent="1" source="cls-AdminVerifService" target="cls-NotifRepo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-adminVerif-Metrics" value="meters" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="cls-AdminVerifService" target="cls-AdminMetrics"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r-adminListing-Listing" value="approves / takes down" style="endArrow=open;dashed=0;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" parent="1" source="cls-AdminListingService" target="cls-Listing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-adminListing-Audit" style="endArrow=open;dashed=0;html=1;rounded=0;" edge="1" parent="1" source="cls-AdminListingService" target="cls-AdminAuditRepo"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r-adminUser-User" value="suspend / reactivate" style="endArrow=open;dashed=0;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" parent="1" source="cls-AdminUserService" target="cls-User"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r-adminUser-Audit" style="endArrow=open;dashed=0;html=1;rounded=0;" edge="1" parent="1" source="cls-AdminUserService" target="cls-AdminAuditRepo"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- AgentProfile shares PK with User -->
        <mxCell id="r-user-agentprofile" value="1 — 0..1" style="endArrow=ERzeroToOne;startArrow=ERone;dashed=0;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="cls-User" target="cls-AgentProfile"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
