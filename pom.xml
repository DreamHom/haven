        <module>modules/feature/photo/api</module>
        <module>modules/feature/photo/impl</module>
        <module>modules/feature/engagement/api</module>
        <module>modules/feature/engagement/impl</module>
        <module>modules/feature/verification/api</module>
        <module>modules/feature/verification/impl</module>
        <module>modules/feature/admin/api</module>
        <module>modules/feature/admin/impl</module>
        <module>modules/integration-tests</module>
        <module>modules/app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <bucket4j.version>8.14.0</bucket4j.version>
        <springdoc.version>2.6.0</springdoc.version>
        <logstash-encoder.version>8.0</logstash-encoder.version>
        <lombok.version>1.18.38</lombok.version>
        <!-- Override Spring Boot 3.3.5's ByteBuddy 1.14.19 which doesn't recognise Java 25
             bytecode. Mockito uses ByteBuddy at runtime to mock concrete classes; without
             this, every @MockBean against a concrete class blows up the application context. -->
        <byte-buddy.version>1.15.11</byte-buddy.version>
    </properties>

    <dependencyManagement>
