                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-offer-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-offer-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-comment-api</artifactId>
