<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.dreamhomes</groupId>
    <artifactId>dreamhomes-haven-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>dreamhomes-haven-parent</name>
    <description>Parent POM for DreamHomes Haven multi-module backend.</description>
    <packaging>pom</packaging>

    <modules>
        <module>modules/core</module>
        <module>modules/core-events</module>
        <module>modules/test-support</module>
        <module>modules/feature/notification/api</module>
        <module>modules/feature/notification/impl</module>
        <module>modules/feature/property/api</module>
        <module>modules/feature/property/impl</module>
        <module>modules/feature/listing/api</module>
        <module>modules/feature/listing/impl</module>
        <module>modules/feature/user/api</module>
        <module>modules/feature/user/impl</module>
        <module>modules/feature/review/api</module>
        <module>modules/feature/auth/api</module>
        <module>modules/feature/auth/impl</module>
        <module>modules/legacy-features</module>
        <module>modules/app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <bucket4j.version>8.14.0</bucket4j.version>
        <springdoc.version>2.6.0</springdoc.version>
        <logstash-encoder.version>8.0</logstash-encoder.version>
        <lombok.version>1.18.38</lombok.version>
        <!-- Override Spring Boot 3.3.5's ByteBuddy 1.14.19 which doesn't recognise Java 25
             bytecode. Mockito uses ByteBuddy at runtime to mock concrete classes; without
             this, every @MockBean against a concrete class blows up the application context. -->
        <byte-buddy.version>1.15.11</byte-buddy.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-core-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-notification-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-notification-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-property-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-property-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-listing-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-listing-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-user-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-user-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-review-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-auth-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-feature-auth-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dreamhomes</groupId>
                <artifactId>haven-legacy-features</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party version pins -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-encoder.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <optional>true</optional>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- ByteBuddy (used by Mockito) needs experimental mode to instrument
                             classes when running on a JDK newer than its officially-supported set. -->
                        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Inherit annotationProcessorPaths in every module that has Lombok. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
