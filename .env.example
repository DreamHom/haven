# ─────────────────────────────────────────────────────────────────────────────
# DreamHomes Haven — environment variable template.
# Local dev:           cp .env.example .env  →  fill in REQUIRED.
# Railway / prod:      paste these into the service Variables tab.
# ─────────────────────────────────────────────────────────────────────────────


# ── REQUIRED — app refuses to boot without these ───────────────────────────

# JWT RS256 keypair. Generate:
#   openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa     -in jwt-private.pem -pubout -out jwt-public.pem
# Local .env: paste as one line, escape newlines as \n.
# Railway: paste with REAL newlines (the dashboard accepts multi-line values).
HAVEN_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE-PKCS8-PEM-HERE\n-----END PRIVATE KEY-----\n"
HAVEN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE-X509-SPKI-PEM-HERE\n-----END PUBLIC KEY-----\n"

# Seeded platform admin (Flyway V11 — self-registration disabled for ADMIN role).
# Hash with: htpasswd -nbBC 10 "" "your-password" | tail -c +2
ADMIN_EMAIL=admin@dreamhomes.local
ADMIN_PASSWORD_HASH=$2a$10$replace-with-real-bcrypt-hash


# ── DATABASE — leave unset for local dev (compose defaults). Railway: ─────
# ── reference the Postgres plugin/service. ────────────────────────────────

DB_HOST=localhost
DB_PORT=5433
DB_NAME=dreamhomes_haven
DB_USERNAME=postgres
DB_PASSWORD=postgres


# ── KAFKA — local dev: leave unset (PLAINTEXT localhost:9092). ────────────
# ── Production: Confluent Cloud (or any SASL_SSL broker). ─────────────────

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Topic config. Confluent Cloud requires replication factor 3 (set in Railway).
HAVEN_KAFKA_TOPIC_PARTITIONS=3
HAVEN_KAFKA_REPLICATION_FACTOR=1


# ── HTTP — port + CORS ─────────────────────────────────────────────────────

# Railway injects PORT automatically; local defaults to 8080.
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ── AUTH — rate limit + optional JWT cookie + reset-token debug ───────────

HAVEN_RATE_LIMIT_AUTH_CAPACITY=30
HAVEN_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Optional cookie auth (first-party SPA). Pair with narrow CORS, NOT "*".
HAVEN_AUTH_JWT_COOKIE_ENABLED=false
HAVEN_AUTH_JWT_COOKIE_NAME=haven_access
HAVEN_AUTH_JWT_COOKIE_SECURE=true
HAVEN_AUTH_JWT_COOKIE_PATH=/
HAVEN_AUTH_JWT_COOKIE_DOMAIN=
HAVEN_AUTH_JWT_COOKIE_SAME_SITE=Lax

# NEVER true in production — leaks reset tokens in the response.
HAVEN_AUTH_DEBUG_RESET_TOKEN=false


# ── PHOTO STORAGE — local placeholder URLs by default. Set to `r2` + ──────
# ── populate the R2 vars to use Cloudflare R2. ────────────────────────────

HAVEN_PHOTOS_STORAGE=local
HAVEN_PHOTOS_R2_ENDPOINT=
HAVEN_PHOTOS_R2_ACCESS_KEY_ID=
HAVEN_PHOTOS_R2_SECRET_ACCESS_KEY=
HAVEN_PHOTOS_R2_BUCKET=
HAVEN_PHOTOS_R2_PUBLIC_BASE_URL=
HAVEN_PHOTOS_AGENT_MARKETING_MAX_BYTES=8388608


# ── DREAM AI — Claude Haiku for natural-language listing search. ──────────
# ── Leave key empty to fall back to the substring stub. ───────────────────

HAVEN_ANTHROPIC_API_KEY=
HAVEN_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
HAVEN_ANTHROPIC_BASE_URL=https://api.anthropic.com
HAVEN_ANTHROPIC_MAX_CANDIDATES=80
HAVEN_ANTHROPIC_MAX_OUTPUT_TOKENS=512
HAVEN_ANTHROPIC_CONNECT_TIMEOUT_MS=10000
HAVEN_ANTHROPIC_READ_TIMEOUT_MS=60000

HAVEN_DREAM_AI_RATE_CAPACITY=30
HAVEN_DREAM_AI_RATE_WINDOW_SECONDS=60


# ── MISC ───────────────────────────────────────────────────────────────────

# Base URI for RFC 7807 ProblemDetail `type` identifiers.
HAVEN_ERRORS_TYPE_BASE=https://github.com/DreamHom/haven/blob/main/docs/errors/
