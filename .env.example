# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored so your secrets never leak.
#
# JWT now uses RS256 (RSA keypair). Generate one with:
#
#   openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa    -in jwt-private.pem -pubout -out jwt-public.pem
#
# Then export the PEM contents as multiline env vars:
#
#   export HAVEN_JWT_PRIVATE_KEY="$(cat jwt-private.pem)"
#   export HAVEN_JWT_PUBLIC_KEY="$(cat jwt-public.pem)"
#
# (dotenv supports multiline values when wrapped in quotes — keep the literal newlines.)

HAVEN_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
PASTE-PKCS8-PEM-HERE
-----END PRIVATE KEY-----"

HAVEN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
PASTE-X509-SPKI-PEM-HERE
-----END PUBLIC KEY-----"

# Seeded platform admin account — required at startup. The Flyway V11 migration
# substitutes these placeholders into the seed insert, so a missing value fails
# Spring property resolution at boot rather than silently shipping a default.
# Generate a bcrypt-10 hash with:
#   htpasswd -nbBC 10 "" "your-real-password" | tail -c +2
ADMIN_EMAIL=admin@dreamhomes.local
ADMIN_PASSWORD_HASH=$2a$10$replace-with-real-bcrypt-hash-from-htpasswd-or-equivalent
