# Copy this file to `.env` and fill in real values for local development.

# JWT RS256 keypair. Generate with:
#   openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
HAVEN_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
PASTE-PKCS8-PEM-HERE
-----END PRIVATE KEY-----"

HAVEN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
PASTE-X509-SPKI-PEM-HERE
-----END PUBLIC KEY-----"

# Seeded admin. Hash with: htpasswd -nbBC 10 "" "your-password" | tail -c +2
ADMIN_EMAIL=admin@dreamhomes.local
ADMIN_PASSWORD_HASH=$2a$10$replace-with-real-bcrypt-hash

# Per-IP rate limit on /api/auth/login + /api/auth/register. Default 30/min is enough
# for a fumbled password + password-manager retry + a handful of QA flows; bump higher
# (e.g. 200) for local dev or test scripts that hammer auth endpoints back-to-back.
HAVEN_RATE_LIMIT_AUTH_CAPACITY=30
HAVEN_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Cloudflare R2. Set storage=local to skip R2 entirely (placeholder URLs only).
HAVEN_PHOTOS_STORAGE=r2
HAVEN_PHOTOS_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
HAVEN_PHOTOS_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
HAVEN_PHOTOS_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
HAVEN_PHOTOS_R2_BUCKET=haven
HAVEN_PHOTOS_R2_PUBLIC_BASE_URL=https://pub-replace-with-real-hash.r2.dev
