# ─────────────────────────────────────────────────────────────────────────────
# DreamHomes Haven — environment variable template.
#
# Local dev:    cp .env.example .env  → fill in the REQUIRED block.
# Railway / production: paste these into the service's Variables tab.
#
# Sections below are ordered REQUIRED → COMMONLY-OVERRIDDEN → OPTIONAL TUNING.
# Defaults shown in comments are what application.yml falls back to when the
# env var is absent.
# ─────────────────────────────────────────────────────────────────────────────


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ REQUIRED — app refuses to boot if any of these are missing.               ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# JWT RS256 keypair. The app validates these are real RSA keys (>= 2048 bits)
# at startup and refuses to boot otherwise.
#
# Generate a fresh pair:
#   openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa     -in jwt-private.pem -pubout -out jwt-public.pem
#
# Local .env: paste the multi-line PEM as a quoted string with literal `\n`
# between rows (the boot script expands them). Railway: paste with REAL
# newlines (the dashboard accepts multi-line values directly).
HAVEN_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE-PKCS8-PEM-HERE\n-----END PRIVATE KEY-----\n"
HAVEN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE-X509-SPKI-PEM-HERE\n-----END PUBLIC KEY-----\n"

# Seeded platform admin (Flyway V11). Self-registration is disabled for ADMINs,
# so this row IS the only way an admin exists. Hash with:
#   htpasswd -nbBC 10 "" "your-password" | tail -c +2
ADMIN_EMAIL=admin@dreamhomes.local
ADMIN_PASSWORD_HASH=$2a$10$replace-with-real-bcrypt-hash
# Optional — display name shown on profile cards. Defaults to "Platform Admin".
# ADMIN_FULL_NAME=Platform Admin


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ DATABASE — Railway needs all five. Local dev uses defaults from           ║
# ║ docker-compose.yml (host port 5433).                                      ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Local dev defaults (from application.yml): localhost / 5433 / dreamhomes_haven / postgres / postgres
# Railway: reference the Postgres plugin/service:
#   DB_HOST=${{Postgres.PGHOST}}
#   DB_PORT=${{Postgres.PGPORT}}
#   DB_NAME=${{Postgres.PGDATABASE}}
#   DB_USERNAME=${{Postgres.PGUSER}}
#   DB_PASSWORD=${{Postgres.PGPASSWORD}}
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=dreamhomes_haven
# DB_USERNAME=postgres
# DB_PASSWORD=postgres


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ KAFKA — local dev defaults to localhost:9092 (compose).                   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Railway: point at your Kafka service (e.g. Kafka.railway.internal:9092) or
# a managed broker (Upstash / Aiven). Setting this to a dummy host causes the
# outbox relay to retry silently — the app still serves HTTP.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic config (defaults: 3 partitions, replication factor 1). Production
# 3-broker cluster should bump replication factor to 3.
# HAVEN_KAFKA_TOPIC_PARTITIONS=3
# HAVEN_KAFKA_REPLICATION_FACTOR=1


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ HTTP — port + CORS.                                                       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Railway injects PORT automatically; the app honors it via server.port=${PORT:8080}.
# Local dev / docker-compose: defaults to 8080.
# PORT=8080

# Comma-separated origins allowed by the CORS filter. Vista's dev server runs
# on :3000. Production: set to your deployed frontend URL(s).
# CORS_ALLOWED_ORIGINS=http://localhost:3000


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ AUTH — rate limit + optional JWT cookie + reset-token debug.              ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Per-IP rate limit on /api/auth/login + /api/auth/register + /api/me/password.
# Default 30/min is enough for a fumbled password + password-manager retry +
# a handful of QA flows. Bump higher (e.g. 200) for test scripts that hammer
# auth endpoints back-to-back.
HAVEN_RATE_LIMIT_AUTH_CAPACITY=30
HAVEN_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Optional JWT cookie support — first-party / same-site SPA (e.g. Vista). When
# enabled, login sets an HttpOnly cookie alongside the bearer token, and the
# auth filter accepts the token from the cookie if Authorization is absent.
# Use with CORS_ALLOWED_ORIGINS narrowed (NOT "*").
# HAVEN_AUTH_JWT_COOKIE_ENABLED=false
# HAVEN_AUTH_JWT_COOKIE_NAME=haven_access
# HAVEN_AUTH_JWT_COOKIE_SECURE=true
# HAVEN_AUTH_JWT_COOKIE_PATH=/
# HAVEN_AUTH_JWT_COOKIE_DOMAIN=                # leave empty for host-only cookies
# HAVEN_AUTH_JWT_COOKIE_SAME_SITE=Lax          # Strict | Lax | None (None requires secure=true)

# When true, /api/auth/forgot-password responses include `debugResetToken` and
# the same raw token is logged at WARN. NEVER enable in production.
# HAVEN_AUTH_DEBUG_RESET_TOKEN=false


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ PHOTO STORAGE — Cloudflare R2. Set storage=local to skip R2 entirely.    ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# `local` synthesises placeholder URLs without persisting bytes (fine for
# dev + CI). `r2` requires the credentials below; the app fails to start if
# the R2 client can't be built.
HAVEN_PHOTOS_STORAGE=local

# R2 credentials (only required when HAVEN_PHOTOS_STORAGE=r2):
# HAVEN_PHOTOS_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# HAVEN_PHOTOS_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# HAVEN_PHOTOS_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# HAVEN_PHOTOS_R2_BUCKET=haven
# HAVEN_PHOTOS_R2_PUBLIC_BASE_URL=https://pub-replace-with-real-hash.r2.dev
# HAVEN_PHOTOS_R2_TOKEN=                       # optional, not read by app — store-only

# Max multipart upload size per agent gallery image (bytes). Default 8 MiB.
# HAVEN_PHOTOS_AGENT_MARKETING_MAX_BYTES=8388608


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ DREAM AI — Anthropic Claude Haiku for natural-language listing search.    ║
# ║ Leave key empty to fall back to the location-substring stub.              ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

HAVEN_ANTHROPIC_API_KEY=

# Optional tuning (defaults shown):
# HAVEN_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# HAVEN_ANTHROPIC_BASE_URL=https://api.anthropic.com
# HAVEN_ANTHROPIC_MAX_CANDIDATES=80
# HAVEN_ANTHROPIC_MAX_OUTPUT_TOKENS=512
# HAVEN_ANTHROPIC_CONNECT_TIMEOUT_MS=10000
# HAVEN_ANTHROPIC_READ_TIMEOUT_MS=60000

# Dream AI rate limit (separate from auth limit — applies to /api/dream-ai/**).
# HAVEN_DREAM_AI_RATE_CAPACITY=30
# HAVEN_DREAM_AI_RATE_WINDOW_SECONDS=60


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ MISC.                                                                     ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Base URI for RFC 7807 ProblemDetail `type` identifiers. Override once you
# have a hosted docs site:
#   HAVEN_ERRORS_TYPE_BASE=https://docs.dreamhomes.com/errors/
# HAVEN_ERRORS_TYPE_BASE=https://github.com/DreamHom/haven/blob/main/docs/errors/
