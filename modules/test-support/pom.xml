<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dreamhomes</groupId>
        <artifactId>dreamhomes-haven-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>haven-test-support</artifactId>
    <name>haven-test-support</name>
    <description>Shared test infrastructure pulled in by every feature-impl as a test-scope
        dependency. Provides AbstractPostgresIT (Testcontainers + EmbeddedKafka, pinned to
        HavenTestApplication via explicit classes=) and HavenTestApplication itself
        (a bare @SpringBootApplication for tests). Deliberately has zero feature-impl
        deps to avoid reactor cycles. Tests that need access to feature aggregates
        (User entity, JwtService, etc.) get them through a higher-level test-fixtures
        / integration-tests module instead.</description>

    <dependencies>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-core</artifactId>
        </dependency>
        <!-- Resources (application.yml, Flyway migrations, logback) for any test
             that brings up a Spring context. app-shared is a leaf module by design —
             see TRADEOFFS for the cycle constraint that forced its existence. -->
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-app-shared</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <!-- Postgres JDBC driver for the Testcontainers @ServiceConnection. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- Flyway runs at Spring Boot startup against the testcontainer DB. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>
</project>
