<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dreamhomes</groupId>
        <artifactId>dreamhomes-haven-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>haven-core</artifactId>
    <name>haven-core</name>
    <description>Cross-cutting Spring infrastructure: DomainException base, RFC 7807 error
        handler, RequestIdFilter (X-Request-ID + MDC), public cache headers interceptor,
        validation annotations (StrictEmail, NotCommonPassword), bucket4j rate limiter,
        Kafka error/DLQ handler. No feature deps. (JwtPrincipal stays in legacy-features
        until Role's home is finalised in P3.)</description>

    <dependencies>
        <!-- web stack: GlobalExceptionHandler returns ResponseEntity, RequestIdFilter is a Servlet filter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- security: AuthRateLimitFilter sits in the filter chain -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- spring-orm: GlobalExceptionHandler maps ObjectOptimisticLockingFailureException
             to RFC 7807 problem responses. Lightweight transitive of spring-data-jpa,
             pulled directly so we don't drag the full JPA starter into core. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
        </dependency>
        <!-- spring-data-commons: WebConfig uses @EnableSpringDataWebSupport to lock the
             Page JSON shape (VIA_DTO). Pulled directly so core can host the cross-cutting
             web config without depending on a JPA starter. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <!-- validation: StrictEmail / NotCommonPassword constraints + validators -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- kafka: KafkaErrorHandlerConfig wires DefaultErrorHandler + DeadLetterPublishingRecoverer -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- bucket4j: AuthRateLimitFilter token bucket -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
        </dependency>
        <!-- springdoc: serves /v3/api-docs and the swagger-ui assets. Lives in core so every
             Spring web boot (production app + ITs in integration-tests) auto-exposes the
             OpenAPI surface; springdoc registers itself via classpath autodetection. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Tests in core are pure JUnit/Mockito unit tests against the validation
             annotations, the request-id filter, and the global exception handler.
             No Spring context, no test-support dependency (which would form a reactor
             cycle since test-support already depends on core). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
