        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>haven-integration-tests</artifactId>
    <name>haven-integration-tests</name>
    <description>Cross-feature flow ITs that bring up a full Spring context spanning
        multiple features. Depends on every feature-impl (legitimately — its job is to
        exercise them together) and houses JwtTestSupport (which needs both UserRepository
        + JwtService and would create a cycle if placed in test-support). No production
        code — only @SpringBootTest classes that drive end-to-end flows.

        Single-feature tests (unit, controller, repository IT) live in their own
        feature-impl module's src/test/java instead — those don't need cross-feature
        wiring and shouldn't pull in the full reactor.</description>

    <dependencies>
        <!-- Every feature-impl: this module's job is full-stack wiring -->
