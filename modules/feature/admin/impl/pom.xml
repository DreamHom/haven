<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dreamhomes</groupId>
        <artifactId>dreamhomes-haven-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../../../pom.xml</relativePath>
    </parent>

    <artifactId>haven-feature-admin-impl</artifactId>
    <name>haven-feature-admin-impl</name>
    <description>Admin moderation implementation: AdminAuditLog entity, repo,
        AdminAuditService (implements AdminAuditApi), per-track services
        (AdminListing/User/Verification), controllers, AdminMetrics.

        Admin is the platform-wide moderation surface — it legitimately needs broader
        access than other features. Admin-impl depends on user-impl and verification-impl
        (intra-aggregate exceptions) for direct entity reads + state mutations that
        haven't been added to those features' APIs yet. Documented in TRADEOFFS.</description>

    <dependencies>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-admin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-listing-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-property-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-user-api</artifactId>
        </dependency>
        <!-- Intra-aggregate exception: admin user-suspension writes User.suspendedAt + tokenVersion. -->
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-user-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-verification-api</artifactId>
        </dependency>
        <!-- Intra-aggregate exception: admin verification decisions read + flip Verification rows. -->
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-verification-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-notification-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
