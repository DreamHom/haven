<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dreamhomes</groupId>
        <artifactId>dreamhomes-haven-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../../../pom.xml</relativePath>
    </parent>

    <artifactId>haven-feature-admin-impl</artifactId>
    <name>haven-feature-admin-impl</name>
    <description>Admin moderation implementation: AdminAuditLog entity, repo,
        AdminAuditService (implements AdminAuditApi), per-track orchestrators
        (AdminListing/User/Verification), controllers, AdminMetrics. User-state
        moderation goes through UserAdminApi; verification decisions go through
        VerificationAdminApi — admin-impl no longer compiles against user-impl or
        verification-impl.</description>

    <dependencies>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-admin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-listing-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-property-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-user-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-verification-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-notification-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Ban cross-feature -impl leaks. The admin-impl exception was retired when
         UserAdminApi + VerificationAdminApi landed. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
