<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dreamhomes</groupId>
        <artifactId>dreamhomes-haven-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>haven-app</artifactId>
    <name>haven-app</name>
    <description>Spring Boot startup module. Owns DreamhomesHavenApplication, application.yml,
        logback-spring.xml, db/migration Flyway scripts, and the static Scalar HTML. Wires
        every -impl module together at runtime. The only module that produces an executable
        Spring Boot fat jar.</description>

    <dependencies>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-core-events</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-notification-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-notification-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-property-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-property-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-listing-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-feature-listing-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-legacy-features</artifactId>
        </dependency>

        <dependency>
            <groupId>com.dreamhomes</groupId>
            <artifactId>haven-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
