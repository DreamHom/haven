<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dreamhomes</groupId>
        <artifactId>dreamhomes-haven-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>haven-core-events</artifactId>
    <name>haven-core-events</name>
    <description>Transactional outbox infrastructure shared by all features that publish
        Kafka events: OutboxEvent entity, repository, after-commit relay, ready-event
        signal, and Micrometer depth gauge. Producers (currently inspection + offer)
        write rows in their domain transaction; the relay drains to Kafka after commit.</description>

    <dependencies>
        <!-- OutboxEvent is a JPA @Entity; OutboxEventRepository is a Spring Data interface -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- OutboxRelay produces to Kafka with acks=all + idempotence -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- OutboxMetrics exposes haven.outbox.unpublished as a Micrometer gauge -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- OutboxRelay serialises payload-jsonb columns via ObjectMapper -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- OutboxRelayTest is a pure Mockito unit test (no DB, no Kafka). The
             repository and metrics ITs that need a real Postgres live in
             integration-tests so we don't form a reactor cycle through test-support. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
