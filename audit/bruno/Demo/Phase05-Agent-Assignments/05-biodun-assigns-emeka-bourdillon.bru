meta {
  name: 05 Biodun requests Emeka on Bourdillon
  type: http
  seq: 5
}

post {
  url: {{host}}/api/listings/{{list_biodun_bourdillon}}/agent-assignment
  body: json
  auth: bearer
}

auth:bearer {
  token: {{biodun_token}}
}

body:json {
  {
    "agentId": {{emeka_id}}
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("assignment_bourdillon_id", res.body.id);
  }
}
