meta {
  name: 07 Biodun requests Emeka on Ikeja
  type: http
  seq: 7
}

post {
  url: {{host}}/api/listings/{{list_biodun_ikeja}}/agent-assignment
  body: json
  auth: bearer
}

auth:bearer {
  token: {{biodun_token}}
}

body:json {
  {
    "agentId": {{emeka_id}}
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("assignment_ikeja_id", res.body.id);
  }
}
