meta {
  name: 01 Amaka requests Emeka on Lekki
  type: http
  seq: 1
}

post {
  url: {{host}}/api/listings/{{list_amaka_lekki}}/agent-assignment
  body: json
  auth: bearer
}

auth:bearer {
  token: {{amaka_token}}
}

body:json {
  {
    "agentId": {{emeka_id}}
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("assignment_lekki_id", res.body.id);
  }
}
