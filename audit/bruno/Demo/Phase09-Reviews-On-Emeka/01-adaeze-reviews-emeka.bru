meta {
  name: 01 Adaeze reviews Amaka (mentions Emeka — 5 stars)
  type: http
  seq: 1
}

post {
  url: {{host}}/api/listings/{{list_amaka_ikate}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adaeze_token}}
}

body:json {
  {
    "revieweeUserId": {{amaka_id}},
    "rating": 5,
    "body": "Excellent end-to-end. Amaka was responsive, Emeka (her agent) was on top of every detail at the inspection and answered every question with a written summary the same evening. Lease paperwork was clean. Would recommend without hesitation."
  }
}

assert {
  res.status: eq 201
}

docs {
  Backend constraint: applicants can review only the listing OWNER (not the
  assigned agent). The text explicitly credits Emeka so the demo narrative —
  "Emeka has track record" — still reads on the listing detail page where
  this review surfaces.
}
