meta {
  name: 01 Adaeze offers ₦2.0M on Ikate
  type: http
  seq: 1
}

post {
  url: {{host}}/api/offers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adaeze_token}}
}

body:json {
  {
    "listingId": {{list_amaka_ikate}},
    "amount": 2000000,
    "currency": "NGN",
    "message": "After the inspection I'm ready to commit. Slightly below ask — happy to lock in for 12 months and pay caution + first quarter upfront."
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("offer_ikate_id", res.body.id);
  }
}
