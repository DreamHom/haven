meta {
  name: 02 Amaka accepts Adaeze's offer
  type: http
  seq: 2
}

patch {
  url: {{host}}/api/offers/{{offer_ikate_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{amaka_token}}
}

body:json {
  {
    "status": "ACCEPTED",
    "reason": "Happy with the price + the upfront commitment. Will draft the lease this week."
  }
}

assert {
  res.status: eq 200
  res.body.status: eq ACCEPTED
}
