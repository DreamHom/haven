meta {
  name: 02 Amaka uploads photo for Ikate listing
  type: http
  seq: 2
}

post {
  url: {{host}}/api/listings/{{list_amaka_ikate}}/photos
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{amaka_token}}
}

body:multipart-form {
  file: @file(photos/ikate-2bed.jpg)
  caption: Renovated 2-bed interior
}

assert {
  res.status: eq 201
}
