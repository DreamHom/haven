meta {
  name: 07 Tunde uploads photo for Ikoyi terrace
  type: http
  seq: 7
}

post {
  url: {{host}}/api/listings/{{list_tunde_ikoyi_terrace}}/photos
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{tunde_token}}
}

body:multipart-form {
  file: @file(photos/ikoyi-terrace.jpg)
  caption: Master bedroom
}

assert {
  res.status: eq 201
}
