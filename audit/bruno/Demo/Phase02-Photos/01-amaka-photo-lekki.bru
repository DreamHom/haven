meta {
  name: 01 Amaka uploads photo for Lekki listing
  type: http
  seq: 1
}

post {
  url: {{host}}/api/listings/{{list_amaka_lekki}}/photos
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{amaka_token}}
}

body:multipart-form {
  file: @file(photos/lekki-3bed.jpg)
  caption: Sea-view living room
}

assert {
  res.status: eq 201
}
