meta {
  name: 01 Adaeze requests inspection on Ikate
  type: http
  seq: 1
}

post {
  url: {{host}}/api/inspections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adaeze_token}}
}

body:json {
  {
    "slotId": {{slot_ikate_id}},
    "notes": "Available any time during the slot. Will come with my partner."
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("inspection_ikate_id", res.body.id);
  }
}
