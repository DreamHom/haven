meta {
  name: 08 Emeka marks Bourdillon inspection COMPLETED
  type: http
  seq: 8
}

post {
  url: {{host}}/api/inspections/{{inspection_bourdillon_id}}/agent/complete
  body: none
  auth: bearer
}

auth:bearer {
  token: {{emeka_token}}
}

assert {
  res.status: eq 200
  res.body.status: eq COMPLETED
}
