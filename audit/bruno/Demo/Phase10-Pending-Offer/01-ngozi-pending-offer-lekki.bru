meta {
  name: 01 Ngozi offers ₦3.2M on Amaka's Lekki (PENDING — no response)
  type: http
  seq: 1
}

post {
  url: {{host}}/api/offers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ngozi_token}}
}

body:json {
  {
    "listingId": {{list_amaka_lekki}},
    "amount": 3200000,
    "currency": "NGN",
    "message": "Liked the photos and the location. Title docs question first — when was the C of O issued? Open to ₦3.2M for a 12-month commitment."
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
}

docs {
  ⚠️ Do NOT add a follow-up "amaka responds" request. The point of this row
  is that it's UNANSWERED on Amaka's dashboard for the demo.
}
