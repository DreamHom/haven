meta {
  name: 02 Biodun submits OWNER_IDENTITY verification
  type: http
  seq: 2
}

post {
  url: {{host}}/api/verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{biodun_token}}
}

body:json {
  {
    "type": "OWNER_IDENTITY",
    "documentRefs": {
      "nin": "23456789012",
      "selfie": "https://r2.example/seed-biodun-selfie.jpg",
      "passport": "https://r2.example/seed-biodun-passport.jpg"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("verification_biodun_id", res.body.id);
  }
}
