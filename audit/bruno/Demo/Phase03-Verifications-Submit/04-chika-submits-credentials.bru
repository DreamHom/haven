meta {
  name: 04 Chika submits AGENT_CREDENTIALS verification
  type: http
  seq: 4
}

post {
  url: {{host}}/api/verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chika_token}}
}

body:json {
  {
    "type": "AGENT_CREDENTIALS",
    "documentRefs": {
      "license_number": "LIC-CK-2014",
      "license_card": "https://r2.example/seed-chika-license.jpg",
      "agency_letter": "https://r2.example/seed-chika-letter.pdf"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("verification_chika_id", res.body.id);
  }
}

docs {
  Chika's verification is intentionally LEFT PENDING in Phase04 — admin
  doesn't decide on it, so it shows up as a pending row in the dashboard.
}
