meta {
  name: 03 Emeka submits AGENT_CREDENTIALS verification
  type: http
  seq: 3
}

post {
  url: {{host}}/api/verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{emeka_token}}
}

body:json {
  {
    "type": "AGENT_CREDENTIALS",
    "documentRefs": {
      "license_number": "LIC-EM-1029",
      "license_card": "https://r2.example/seed-emeka-license.jpg",
      "agency_letter": "https://r2.example/seed-emeka-letter.pdf"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("verification_emeka_id", res.body.id);
  }
}
