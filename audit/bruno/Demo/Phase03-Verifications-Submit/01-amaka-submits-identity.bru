meta {
  name: 01 Amaka submits OWNER_IDENTITY verification
  type: http
  seq: 1
}

post {
  url: {{host}}/api/verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{amaka_token}}
}

body:json {
  {
    "type": "OWNER_IDENTITY",
    "documentRefs": {
      "nin": "12345678901",
      "selfie": "https://r2.example/seed-amaka-selfie.jpg",
      "id_card": "https://r2.example/seed-amaka-nimc.jpg"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("verification_amaka_id", res.body.id);
  }
}
