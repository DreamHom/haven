meta {
  name: 02 Login Biodun
  type: http
  seq: 2
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "biodun.developer.{{run_tag}}@dreamhomes.local",
    "password": "OjoduBerger2026!"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setVar("biodun_jwt", res.body.token);
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}
