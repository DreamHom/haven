meta {
  name: 14 Open overlapping slot — should be rejected
  type: http
  seq: 14
}

post {
  url: {{host}}/listings/{{listingId}}/slots
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "startsAt": "2026-05-16T15:00:00Z",
    "endsAt": "2026-05-16T17:00:00Z"
  }
}

assert {
  res.status: eq 409
}

docs {
  Accidentally pasting the wrong end-time and creating an overlap. The DB
  GiST constraint should catch this. Looking for a friendly 409 with a
  clear detail message ("slot overlaps an existing active slot").
}
