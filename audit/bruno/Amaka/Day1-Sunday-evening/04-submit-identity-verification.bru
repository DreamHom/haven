meta {
  name: 04 Submit OWNER_IDENTITY verification
  type: http
  seq: 4
}

post {
  url: {{host}}/verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "type": "OWNER_IDENTITY",
    "documentRefs": {
      "nin_slip": {
        "url": "https://res.cloudinary.com/demo/image/upload/v1700000000/amaka_nin.jpg",
        "kind": "NIN"
      },
      "c_of_o": {
        "url": "https://res.cloudinary.com/demo/image/upload/v1700000000/amaka_cofo_lekki.pdf",
        "kind": "C_OF_O",
        "issuingAuthority": "Lagos State Lands Bureau"
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
  res.body.type: eq OWNER_IDENTITY
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("verificationId", res.body.id);
  }
}

docs {
  Submitting my NIN slip + my late father's C of O. The schema for documentRefs
  is just "object of objects" with no example — I had to guess the shape.
  I'm modelling it like { docName: { url, kind, ... } }.
}
