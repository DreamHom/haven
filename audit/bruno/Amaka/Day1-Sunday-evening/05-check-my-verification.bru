meta {
  name: 05 Check verification status
  type: http
  seq: 5
}

get {
  url: {{host}}/verifications/mine
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

