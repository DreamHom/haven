meta {
  name: 01 Register Amaka (OWNER)
  type: http
  seq: 1
}

post {
  url: {{host}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "amaka.okafor@demo.dreamhomes.local",
    "password": "{{password}}",
    "fullName": "Amaka Okafor",
    "displayName": "Amaka",
    "phone": "+2348031000001",
    "role": "OWNER"
  }
}

assert {
  res.status: eq 202
}

docs {
  Solo Lekki landlord — two flats, no agent. Anti-enum 202 either way.
}
