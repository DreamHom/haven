meta {
  name: 02 Login Biodun
  type: http
  seq: 2
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "biodun.adekunle@demo.dreamhomes.local",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.role: eq OWNER
}

script:post-response {
  if (res.status === 200 && res.body && res.body.token) {
    bru.setVar("biodun_token", res.body.token);
    bru.setVar("biodun_id", res.body.userId);
  }
}
