meta {
  name: 11 Funmi — Property Yaba (studio)
  type: http
  seq: 11
}

post {
  url: {{host}}/api/properties
  body: json
  auth: bearer
}

auth:bearer {
  token: {{funmi_token}}
}

body:json {
  {
    "type": "APARTMENT",
    "address": "9 Herbert Macaulay Way, Yaba, Lagos",
    "bedrooms": 1,
    "bathrooms": 1,
    "sizeSqm": 35,
    "description": "Self-contained studio with kitchenette. Security door + smart meter. Ideal for postgrad students.",
    "latitude": 6.51060,
    "longitude": 3.37430
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("prop_funmi_yaba_studio", res.body.id);
  }
}
