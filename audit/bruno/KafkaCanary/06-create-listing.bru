meta {
  name: 06 Owner creates canary listing (RENT)
  type: http
  seq: 6
}

post {
  url: {{host}}/api/listings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{owner_token}}
}

body:json {
  {
    "propertyId": {{canary_property_id}},
    "listingType": "RENT",
    "askingPrice": 1000000,
    "currency": "NGN",
    "title": "Canary listing — ignore",
    "description": "Disposable listing; used by Kafka canary to give the offer a target."
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("canary_listing_id", res.body.id);
  }
}
