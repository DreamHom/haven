meta {
  name: 01 Register canary OWNER
  type: http
  seq: 1
}

post {
  url: {{host}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "kafka-canary-owner@demo.dreamhomes.local",
    "password": "{{password}}",
    "fullName": "Kafka Canary Owner",
    "displayName": "K. Owner",
    "phone": "+2348099000001",
    "role": "OWNER"
  }
}

assert {
  res.status: eq 202
}

docs {
  Throwaway owner — exists only so we have somewhere to point an offer.
  202 either way (new or already taken — anti-enum contract).
}
