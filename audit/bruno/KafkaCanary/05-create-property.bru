meta {
  name: 05 Owner creates canary property
  type: http
  seq: 5
}

post {
  url: {{host}}/api/properties
  body: json
  auth: bearer
}

auth:bearer {
  token: {{owner_token}}
}

body:json {
  {
    "type": "APARTMENT",
    "address": "Kafka Canary Test Address, Lagos",
    "bedrooms": 2,
    "bathrooms": 1,
    "sizeSqm": 60,
    "description": "Disposable property created by the Kafka canary collection."
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("canary_property_id", res.body.id);
  }
}
