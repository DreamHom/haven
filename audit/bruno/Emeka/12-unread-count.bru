meta {
  name: 12 Unread badge count
  type: http
  seq: 12
}

get {
  url: {{host}}/api/notifications/mine/unread-count
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

docs {
  The little red dot on the bell icon. Cheap, important.

  Expected: 200 with a count >= 0.
}
