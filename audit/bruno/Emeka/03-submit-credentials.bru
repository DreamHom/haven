meta {
  name: 03 Submit AGENT_CREDENTIALS verification
  type: http
  seq: 3
}

post {
  url: {{host}}/api/verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "type": "AGENT_CREDENTIALS",
    "documentRefs": {
      "redan_certificate": {
        "url": "https://res.cloudinary.com/demo/image/upload/v1/sample-cert.jpg",
        "issuedBy": "Real Estate Developers Association of Nigeria",
        "licenseNumber": "REDAN-PH-2024-0073",
        "issuedOn": "2024-03-12"
      },
      "nin_slip": {
        "url": "https://res.cloudinary.com/demo/image/upload/v1/sample-nin.jpg",
        "nin": "12345678901"
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.status: eq PENDING
  res.body.type: eq AGENT_CREDENTIALS
  res.body.submitterUserId: isDefined
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("verification_id", res.body.id);
  }
}

docs {
  About fifteen minutes later — I scanned my REDAN certificate and pulled my
  NIN slip from my Google Drive. The schema accepts a free-form
  `documentRefs` map; the spec gives me zero examples of what keys it wants,
  so I'm making reasonable choices and writing this down as a finding.

  Expected:
  - 201 with status=PENDING
  - my user ID stamped as submitter (no targetUserId needed for AGENT_CREDENTIALS)
  - the response back tells me what I just submitted
}
