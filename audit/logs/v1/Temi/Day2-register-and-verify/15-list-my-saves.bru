meta {
  name: 15-See my saved list
  type: http
  seq: 15
}

get {
  url: {{host}}/api/saves/mine?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{temi_token}}
}

assert {
  res.status: eq 200
}

docs {
  Coming back to my saves to double-check it's there. Like the
  "favourites" tab on Pinterest.
}
