meta {
  name: 32-Unsave a listing I'm no longer interested in
  type: http
  seq: 32
}

delete {
  url: {{host}}/api/listings/3/save
  body: none
  auth: bearer
}

auth:bearer {
  token: {{temi_token}}
}

assert {
  res.status: in [204, 401, 404]
}

docs {
  Cleaning up my saves now that I have a place. Idempotent — even
  if it wasn't saved I get 204. Nice.
}
