meta {
  name: 06-CreateSecondPropertyChevron
  type: http
  seq: 6
}

post {
  url: {{host}}/api/properties
  body: json
  auth: bearer
}

auth:bearer {
  token: {{amakaJwt}}
}

body:json {
  {
    "type": "APARTMENT",
    "address": "8 Chevron Drive, Lekki Phase 2, Lagos",
    "bedrooms": 3,
    "bathrooms": 3,
    "sizeSqm": 132,
    "description": "3-bed apartment with BQ. Compound is gated, generator-included, swimming pool. Walking distance to Chevron roundabout."
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  bru.setVar("amakaProperty2Id", res.body.id);
}

docs {
  # The second flat — the bigger Chevron Drive one I inherited.

  ✅ Worked. So I have two properties now, but no way to see them in a
  list view that's mine. I'm tracking IDs in my head.
}
