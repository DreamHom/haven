meta {
  name: 02-SubmitOwnerIdentity
  type: http
  seq: 2
}

post {
  url: {{host}}/api/verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{amakaJwt}}
}

body:json {
  {
    "type": "OWNER_IDENTITY",
    "documentRefs": {
      "certificateOfOccupancy": {
        "url": "https://res.cloudinary.com/demo/image/upload/sample.jpg",
        "label": "C of O — Plot 14, Admiralty Way, Lekki Phase 1"
      },
      "nin": {
        "url": "https://res.cloudinary.com/demo/image/upload/sample.jpg",
        "number": "12345678901"
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
  res.body.type: eq OWNER_IDENTITY
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("amakaVerificationId", res.body.id);
  }
}

docs {
  # I want my verified-owner badge so people don't think I'm a scammer.

  No file-upload endpoint exists for documents — I'm forced to provide URLs
  to documents that already live somewhere else. As a 41-year-old who barely
  uses Cloudinary, that's a real problem. In practice I'd have to find some
  third-party site to host my C of O scan first, then paste the URL here.
  My C of O is sensitive — I do NOT want it sitting on a random image host.

  The schema says `documentRefs` is `object` with `additionalProperties:
  object` — there's NO description of what shape that object should have.
  I'm guessing. The spec gives me zero example. I might be doing this wrong
  and won't know until an admin rejects me.

  Also no preview of how this looks to the admin. I'm sending blind.
}
