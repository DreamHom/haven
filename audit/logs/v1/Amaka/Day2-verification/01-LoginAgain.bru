meta {
  name: 01-LoginAgain
  type: http
  seq: 1
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{amakaEmail}}",
    "password": "{{amakaPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}

script:post-response {
  bru.setVar("amakaJwt", res.body.token);
}

docs {
  # Day 2, ~7am — before work, with my coffee.

  Re-logging in. The app didn't tell me how long my token lasts so I'll
  just sign in fresh to be safe.
}
