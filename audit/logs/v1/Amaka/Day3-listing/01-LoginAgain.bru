meta {
  name: 01-LoginAgain
  type: http
  seq: 1
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{amakaEmail}}",
    "password": "{{amakaPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}

script:post-response {
  bru.setVar("amakaJwt", res.body.token);
}

docs {
  # Day 3, ~6:30am — Saturday morning, full pot of coffee.

  Today's the day I list the first flat. My sister Funke is coming in an
  hour to help with the photos.
}
