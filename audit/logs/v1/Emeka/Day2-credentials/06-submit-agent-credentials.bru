meta {
  name: 06-Submit my AGENT_CREDENTIALS verification
  type: http
  seq: 6
}

post {
  url: {{host}}/api/verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{emeka_jwt}}
}

body:json {
  {
    "type": "AGENT_CREDENTIALS",
    "documentRefs": {
      "kind": "NIPRA_LICENSE",
      "ref": "https://files.dreamhomes.example/agents/emeka-okorie-nipra-license.pdf",
      "licenseNumber": "NIPRA/RC/2019/PH/0421",
      "issuedAt": "2019-08-12",
      "issuer": "Nigerian Institution of Estate Surveyors and Valuers (PH chapter)"
    }
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
  res.body.type: eq AGENT_CREDENTIALS
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("emeka_verification_id", res.body.id);
  }
}

docs {
  This is the badge that decides whether I'm taken seriously. The
  spec wants `documentRefs` as a free-form JSON object — no file
  upload anywhere. I'm passing a URL to my license PDF and hoping
  the admin can open it.

  GAP: I would have expected a multipart upload like
  `POST /verifications/{id}/files` so my actual scanned license lives
  inside the system. Right now I have to host the PDF myself, which
  for a solo agent in PH means... what, Google Drive with public
  link? That's a security smell.

  GAP 2: there's no GET /verifications/mine. After I submit, I have
  zero way to check the status from my end. I just have to wait and
  hope a notification arrives.
}
