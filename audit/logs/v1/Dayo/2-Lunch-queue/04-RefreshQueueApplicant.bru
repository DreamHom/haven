meta {
  name: 04-RefreshQueueApplicant
  type: http
  seq: 4
}

get {
  url: {{host}}/api/admin/verifications?type=APPLICANT_IDENTITY&page=0&size=20
  auth: bearer
}

params:query {
  type: APPLICANT_IDENTITY
  page: 0
  size: 20
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res && res.body && Array.isArray(res.body.content) && res.body.content.length > 0) {
    bru.setVar("applicantVerificationId", res.body.content[0].id);
  }
}

docs {
  # Pulling applicant ID queue separately since the API forces type-by-type.
}
