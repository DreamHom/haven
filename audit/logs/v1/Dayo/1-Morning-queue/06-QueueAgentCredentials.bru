meta {
  name: 06-QueueAgentCredentials
  type: http
  seq: 6
}

get {
  url: {{host}}/api/admin/verifications?type=AGENT_CREDENTIALS&page=0&size=20
  auth: bearer
}

params:query {
  type: AGENT_CREDENTIALS
  page: 0
  size: 20
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res && res.body && Array.isArray(res.body.content) && res.body.content.length > 0) {
    bru.setVar("agentVerificationId", res.body.content[0].id);
    bru.setVar("agentSubmitterId", res.body.content[0].submitterUserId);
  }
}

docs {
  # Third of four. Agent credentials are the highest-leverage badge — an
  # AGENT_CREDENTIALS approval is what unlocks somebody to charge fees and
  # represent owners. I should be able to filter to just these by default.
}
