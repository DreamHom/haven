meta {
  name: 03-RejectAgentCredentialsBadDocs
  type: http
  seq: 3
}

post {
  url: {{host}}/api/admin/verifications/{{agentVerificationId}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "reason": "The licence reference you submitted does not match any record in the LSREC (Lagos State Real Estate Commission) registry I checked against. Either the licence number is mistyped or the document is not authentic. Please resubmit with a clear scan of your LSREC certificate showing the registration number and full name. If you don't yet hold an LSREC licence, do not submit AGENT_CREDENTIALS — submit OWNER or APPLICANT and operate without the verified-agent badge."
  }
}

assert {
  res.status: eq 200
}

docs {
  # Heavy rejection — and notice how much room my reason needs.
  # Spec allows 1000 chars which is reasonable. Persona doc says detailed
  # rejection reasons are non-negotiable, so I'm stress-testing that.
}
