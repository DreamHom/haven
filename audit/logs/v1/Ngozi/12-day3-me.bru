meta {
  name: 12-day3-me
  type: http
  seq: 12
}

get {
  url: {{host}}/api/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ngozi_token}}
}

assert {
  res.status: eq 200
  res.body.role: eq APPLICANT
}

docs {
  # Confirming the JWT is real and the role stuck. If /me says
  # role: OWNER instead of APPLICANT, that's a serious red flag and
  # I close the tab.
}
